# Environment variables required by EcoScore_online_app.R
# Replace the placeholders with the values from Supabase.
# Do NOT commit a file containing the real password to GitHub.

DB_HOST=your-supabase-pooler-host
DB_PORT=5432
DB_NAME=postgres
DB_USER=your-supabase-pooler-user
DB_PASSWORD=your-database-password
DB_SSLMODE=require
